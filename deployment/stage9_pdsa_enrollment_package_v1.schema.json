{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptohunter.invalid/schemas/stage9-pdsa-enrollment-package-v1.json",
  "title": "CryptoHunter PDSAEnrollmentPackageV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "serialization_profile", "payload", "payload_digest", "signature_profile", "threshold", "signatures"],
  "properties": {
    "schema": {"const": "CryptoHunter.PDSAEnrollmentPackageV1"}, "version": {"const": 1},
    "serialization_profile": {"const": "CRYPTOHUNTER_CANONICAL_JSON_V1"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "purpose", "release_policy_digest", "enrollment_id", "device_identity_binding", "target_tpm", "k_psa", "generation", "state_enrollment_digest"],
      "properties": {
        "schema": {"const": "CryptoHunter.PDSAEnrollmentPayloadV1"}, "version": {"const": 1},
        "purpose": {"enum": ["PRODUCTION", "TEST_ONLY"]}, "release_policy_digest": {"$ref": "#/$defs/hex32"},
        "enrollment_id": {"$ref": "#/$defs/id"}, "device_identity_binding": {"$ref": "#/$defs/hex32"},
        "target_tpm": {"type": "object", "additionalProperties": false, "required": ["ek_certificate_sha256", "ak_public_sha256", "ak_attestation_sha256"], "properties": {
          "ek_certificate_sha256": {"$ref": "#/$defs/hex32"}, "ak_public_sha256": {"$ref": "#/$defs/hex32"}, "ak_attestation_sha256": {"$ref": "#/$defs/hex32"}
        }},
        "k_psa": {"type": "object", "additionalProperties": false, "required": ["key_id", "tpmt_public_hex", "name_hex", "creation_attestation_sha256", "provenance"], "properties": {
          "key_id": {"$ref": "#/$defs/id"}, "tpmt_public_hex": {"type": "string", "pattern": "^[0-9a-f]+$"}, "name_hex": {"type": "string", "pattern": "^000b[0-9a-f]{64}$"},
          "creation_attestation_sha256": {"$ref": "#/$defs/hex32"}, "provenance": {"enum": ["TARGET_TPM_GENERATED", "TEST_FIXTURE"]}
        }},
        "generation": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}, "state_enrollment_digest": {"$ref": "#/$defs/hex32"}
      }
    },
    "payload_digest": {"$ref": "#/$defs/hex32"}, "signature_profile": {"const": "Ed25519-SHA256-DIGEST-CH-STAGE9-PDSA-ENROLLMENT-V1"},
    "threshold": {"type": "integer", "minimum": 1},
    "signatures": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["signer_id", "signature_hex"], "properties": {
      "signer_id": {"$ref": "#/$defs/id"}, "signature_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
    }}}
  },
  "$defs": {"hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}}
}
