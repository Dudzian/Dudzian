[Unit]
Description=CryptoHunter HistoryAttestationSigner diagnostics (production signing blocked)
ConditionPathExists=/etc/cryptohunter/root-proof-issuer/installation.json
ConditionPathExists=/etc/cryptohunter/history-attestation-signer/custody.json

[Service]
Type=simple
User=cryptohunter-history-attestation-signer
Group=cryptohunter-history-attestation-signer
WorkingDirectory=/opt/cryptohunter
ExecStart=/opt/cryptohunter/venv/bin/python -m deployment.production_signer_service history_signer --serve
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
PrivateIPC=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/cryptohunter/history-attestation-signer
ReadWritePaths=/run/cryptohunter/history-attestation-signer
InaccessiblePaths=/var/lib/cryptohunter/root-proof-signer /etc/cryptohunter/root-proof-signer
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RemoveIPC=yes
UMask=0117
TimeoutStopSec=5s
KillMode=control-group
