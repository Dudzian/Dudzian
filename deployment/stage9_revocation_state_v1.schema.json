{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptohunter.invalid/schemas/stage9-revocation-state-v1.json",
  "title": "CryptoHunter Stage9RevocationStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "serialization_profile", "payload", "payload_digest", "signature_profile", "threshold", "signatures"],
  "properties": {
    "schema": {"const": "CryptoHunter.Stage9RevocationStateV1"},
    "version": {"const": 1},
    "serialization_profile": {"const": "CRYPTOHUNTER_CANONICAL_JSON_V1"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "sequence", "previous_state_digest", "revoked_root_signer_ids", "revoked_pdsa_signer_ids", "effective_at", "authority"],
      "properties": {
        "schema": {"const": "CryptoHunter.Stage9RevocationPayloadV1"},
        "version": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "previous_state_digest": {"$ref": "#/$defs/hex32"},
        "revoked_root_signer_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/keyId"}},
        "revoked_pdsa_signer_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/keyId"}},
        "effective_at": {"type": "string", "format": "date-time"},
        "authority": {"const": "PRODUCT_RELEASE_ROOT_QUORUM"}
      }
    },
    "payload_digest": {"$ref": "#/$defs/hex32"},
    "signature_profile": {"const": "Ed25519-SHA256-DIGEST-CH-STAGE9-REVOCATION-V1"},
    "threshold": {"const": 2},
    "signatures": {
      "type": "array", "minItems": 2,
      "items": {"type": "object", "additionalProperties": false, "required": ["signer_id", "signature_hex"], "properties": {
        "signer_id": {"$ref": "#/$defs/keyId"},
        "signature_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }}
    }
  },
  "$defs": {
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "keyId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}
  }
}
