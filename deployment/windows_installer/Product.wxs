<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Canonical production MSI.  Private keys are generated by the deferred
       provisioner and are deliberately not represented as MSI files. -->
  <Package Name="CryptoHunter" Manufacturer="CryptoHunter" Version="$(ProductVersion)"
           UpgradeCode="D79EA891-1C35-4CBC-B761-C5A5A46D8C70" Scope="perMachine"
           InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer CryptoHunter is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CryptoHunter">
        <Component Id="BackendComponent" Guid="*" Bitness="always64">
          <File Id="BackendExe" Source="$(PayloadDir)\CryptoHunterBackend.exe" KeyPath="yes" />
          <ServiceInstall Id="BackendInstall" Name="CryptoHunterBackend"
             DisplayName="CryptoHunter Backend" Type="ownProcess" Start="auto"
             Account="NT SERVICE\CryptoHunterBackend" ErrorControl="normal" Vital="yes">
            <ServiceDependency Id="CryptoHunterPostgreSQL" />
          </ServiceInstall>
          <ServiceControl Id="BackendControl" Name="CryptoHunterBackend"
             Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="VerifierComponent" Guid="*" Bitness="always64">
          <File Id="VerifierExe" Source="$(PayloadDir)\CryptoHunterFreshnessVerifier.exe" KeyPath="yes" />
          <!-- Demand start: verification is invoked only for semantic proof work. -->
          <ServiceInstall Id="VerifierInstall" Name="CryptoHunterFreshnessVerifier"
             DisplayName="CryptoHunter Freshness Verifier" Type="ownProcess" Start="demand"
             Account="NT SERVICE\CryptoHunterFreshnessVerifier" ErrorControl="normal" Vital="yes" />
          <ServiceControl Id="VerifierControl" Name="CryptoHunterFreshnessVerifier"
             Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Directory Id="PostgreSQLFolder" Name="PostgreSQL">
          <Component Id="PostgreSQLServiceComponent" Guid="*" Bitness="always64">
            <File Id="PostgreSQLHostExe" Source="$(PayloadDir)\CryptoHunterPostgreSQL.exe" KeyPath="yes" />
            <ServiceInstall Id="PostgreSQLInstall" Name="CryptoHunterPostgreSQL"
               DisplayName="CryptoHunter Private PostgreSQL" Type="ownProcess" Start="auto"
               Account="NT SERVICE\CryptoHunterPostgreSQL" ErrorControl="normal" Vital="yes" />
            <ServiceControl Id="PostgreSQLControl" Name="CryptoHunterPostgreSQL"
               Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
        </Directory>
        <Component Id="ProvisionComponent" Guid="*" Bitness="always64">
          <File Id="ProvisionExe" Source="$(PayloadDir)\CryptoHunterProvision.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <!-- Provisioner creates this only after its durable ownership journal. -->
      <Directory Id="PROGRAMDATAROOT" Name="CryptoHunter" />
    </StandardDirectory>

    <CustomAction Id="ProvisionMachine" FileRef="ProvisionExe"
      ExeCommand="install --program-files &quot;[INSTALLFOLDER].&quot; --program-data &quot;[PROGRAMDATAROOT].&quot;"
      Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RollbackProvisionMachine" FileRef="ProvisionExe"
      ExeCommand="rollback --program-files &quot;[INSTALLFOLDER].&quot; --program-data &quot;[PROGRAMDATAROOT].&quot;"
      Execute="rollback" Impersonate="no" Return="ignore" HideTarget="yes" />
    <CustomAction Id="CommitProvisionMachine" FileRef="ProvisionExe"
      ExeCommand="commit --program-files &quot;[INSTALLFOLDER].&quot; --program-data &quot;[PROGRAMDATAROOT].&quot;"
      Execute="commit" Impersonate="no" Return="check" HideTarget="yes" />
    <InstallExecuteSequence>
      <!-- InstallServices creates all live SCM authorities before SID lookup/DACL. -->
      <Custom Action="RollbackProvisionMachine" After="InstallServices" Condition="NOT Installed" />
      <Custom Action="ProvisionMachine" Before="StartServices" Condition="NOT Installed" />
      <Custom Action="CommitProvisionMachine" After="StartServices" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <Feature Id="Complete" Title="CryptoHunter" Level="1">
      <ComponentRef Id="BackendComponent" />
      <ComponentRef Id="VerifierComponent" />
      <ComponentRef Id="PostgreSQLServiceComponent" />
      <ComponentRef Id="ProvisionComponent" />
      <Files Include="$(PayloadDir)\PostgreSQL\**" Directory="PostgreSQLFolder" />
    </Feature>
  </Package>
</Wix>
